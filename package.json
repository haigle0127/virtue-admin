{
  "name": "vue-element-admin",
  "version": "4.3.0",
  "description": "A magical vue admin. An out-of-box UI solution for enterprise applications. Newest development stack of vue. Lots of awesome features",
  "author": "Pan <panfree23@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 9527 --open",
    "build:prod": "vite build",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview --port 9526",
    "lint": "eslint --ext .js,.vue src",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
    "new": "plop"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-ui",
    "boilerplate",
    "admin-template",
    "management-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PanJiaChen/vue-element-admin.git"
  },
  "bugs": {
    "url": "https://github.com/PanJiaChen/vue-element-admin/issues"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.8.0",
    "clipboard": "2.0.4",
    "codemirror": "5.45.0",
    "driver.js": "0.9.5",
    "dropzone": "5.5.1",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.0",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.1.0",
    "js-cookie": "^3.0.0",
    "jsonlint": "1.6.3",
    "jszip": "^3.10.0",
    "normalize.css": "^8.0.0",
    "nprogress": "0.2.0",
    "path-to-regexp": "2.4.0",
    "pinia": "^3.0.4",
    "screenfull": "^6.0.0",
    "showdown": "^1.9.1",
    "sortablejs": "^1.15.0",
    "tui-editor": "1.3.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^9.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "1.3.1",
    "lint-staged": "8.1.5",
    "mockjs": "1.0.1-beta3",
    "plop": "2.3.0",
    "sass": "^1.26.2",
    "svgo": "1.2.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "engines": {
    "node": ">=8.9",
    "npm": ">= 3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
